# =============================================================================
# OpenClaw Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# IMPORTANT: Never commit .env to version control!
#
# Place this file in:
#   - /opt/openclaw/.env (for Docker deployments)
#   - ~/.openclaw/.env (for native installations)
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Image Configuration
# -----------------------------------------------------------------------------

# Docker image name (built locally or from registry)
OPENCLAW_IMAGE=openclaw:latest

# -----------------------------------------------------------------------------
# Gateway Configuration
# -----------------------------------------------------------------------------

# Gateway authentication token
# Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=your-64-character-hex-token-here

# Gateway bind mode: loopback, lan, tailnet, custom
# Use "loopback" when using Tailscale Serve (recommended)
OPENCLAW_GATEWAY_BIND=loopback

# Gateway port
OPENCLAW_GATEWAY_PORT=18789

# Gateway password (required for Tailscale Funnel public access)
# OPENCLAW_GATEWAY_PASSWORD=your-strong-password

# -----------------------------------------------------------------------------
# State Directory Configuration
# -----------------------------------------------------------------------------

# OpenClaw configuration directory (contains openclaw.json, credentials, etc.)
OPENCLAW_CONFIG_DIR=/home/openclaw/.openclaw

# Agent workspace directory (contains skills, prompts, memories)
OPENCLAW_WORKSPACE_DIR=/home/openclaw/.openclaw/workspace

# XDG config home (used by some tools)
XDG_CONFIG_HOME=/home/openclaw/.openclaw

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------

# Keyring password for secure credential storage (gmail, etc.)
# Generate with: openssl rand -hex 16
GOG_KEYRING_PASSWORD=your-32-character-hex-password

# -----------------------------------------------------------------------------
# Model Provider API Keys
# -----------------------------------------------------------------------------

# Anthropic API Key (recommended)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# OpenAI API Key (optional)
# Get from: https://platform.openai.com/
# OPENAI_API_KEY=sk-xxxxx

# OpenRouter API Key (optional - for model routing)
# OPENROUTER_API_KEY=sk-or-xxxxx

# -----------------------------------------------------------------------------
# Messaging Channel Tokens
# -----------------------------------------------------------------------------

# Telegram Bot Token
# Create via @BotFather: https://t.me/BotFather
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Discord Bot Token
# Create at: https://discord.com/developers/applications
# DISCORD_BOT_TOKEN=your-discord-bot-token

# Slack Tokens
# Create at: https://api.slack.com/apps
# SLACK_BOT_TOKEN=xoxb-xxxxx
# SLACK_APP_TOKEN=xapp-xxxxx

# Google Chat credentials (JSON file path)
# GOOGLE_CHAT_CREDENTIALS=/path/to/credentials.json

# -----------------------------------------------------------------------------
# Optional: ElevenLabs Voice (for Talk Mode)
# -----------------------------------------------------------------------------

# ELEVENLABS_API_KEY=xxxxx

# -----------------------------------------------------------------------------
# Optional: Browser Control
# -----------------------------------------------------------------------------

# Enable browser control
# OPENCLAW_BROWSER_ENABLED=true

# Browser profile directory
# OPENCLAW_BROWSER_PROFILE_DIR=/home/openclaw/.openclaw/browser

# -----------------------------------------------------------------------------
# Node.js Configuration
# -----------------------------------------------------------------------------

# Node environment
NODE_ENV=production

# Terminal type (for color support)
TERM=xterm-256color

# Home directory (for Docker)
HOME=/home/node
